<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_LoanRisk"
                   targetNamespace="http://camunda.org/schema/1.0/bpmn"
                   exporter="Claude" exporterVersion="1.0">

  <bpmn:process id="Process_LoanApplicationRisk" name="Loan Application Risk Routing" isExecutable="true">

    <bpmn:startEvent id="StartEvent_LoanSubmitted" name="Loan Application Submitted">
      <bpmn:outgoing>Flow_ToEvaluateRisk</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:businessRuleTask id="Task_EvaluateLoanRisk" name="Evaluate Loan Risk"
        camunda:decisionRef="evaluate-loan-risk"
        camunda:mapDecisionResult="singleResult"
        camunda:resultVariable="riskResult">
      <bpmn:incoming>Flow_ToEvaluateRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_RiskRoute" name="Risk Tier?">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Low</bpmn:outgoing>
      <bpmn:outgoing>Flow_Medium</bpmn:outgoing>
      <bpmn:outgoing>Flow_High</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_AutoApprove" name="Auto-Approve and Disburse"
        camunda:type="external" camunda:topic="loan-auto-approve">
      <bpmn:incoming>Flow_Low</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndApproved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_UnderwriterReview" name="Underwriter Review">
      <bpmn:incoming>Flow_Medium</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndReview</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_AutoReject" name="Auto-Reject Notification"
        camunda:type="external" camunda:topic="loan-auto-reject">
      <bpmn:incoming>Flow_High</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Approved" name="Loan Approved">
      <bpmn:incoming>Flow_ToEndApproved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Review" name="Sent for Review">
      <bpmn:incoming>Flow_ToEndReview</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Rejected" name="Loan Rejected">
      <bpmn:incoming>Flow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToEvaluateRisk" sourceRef="StartEvent_LoanSubmitted" targetRef="Task_EvaluateLoanRisk" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="Task_EvaluateLoanRisk" targetRef="Gateway_RiskRoute" />

    <bpmn:sequenceFlow id="Flow_Low" name="LOW" sourceRef="Gateway_RiskRoute" targetRef="Task_AutoApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="feel">riskResult.riskTier = "LOW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Medium" name="MEDIUM or Manual Review" sourceRef="Gateway_RiskRoute" targetRef="Task_UnderwriterReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="feel">riskResult.riskTier = "MEDIUM" or riskResult.requiresManualReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_High" name="HIGH and not Manual Review" sourceRef="Gateway_RiskRoute" targetRef="Task_AutoReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="feel">riskResult.riskTier = "HIGH" and riskResult.requiresManualReview = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ToEndApproved" sourceRef="Task_AutoApprove" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="Flow_ToEndReview" sourceRef="Task_UnderwriterReview" targetRef="End_Review" />
    <bpmn:sequenceFlow id="Flow_ToEndRejected" sourceRef="Task_AutoReject" targetRef="End_Rejected" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LoanApplicationRisk">

      <bpmndi:BPMNShape id="StartEvent_LoanSubmitted_di" bpmnElement="StartEvent_LoanSubmitted">
        <dc:Bounds x="180" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="243" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_EvaluateLoanRisk_di" bpmnElement="Task_EvaluateLoanRisk">
        <dc:Bounds x="270" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_RiskRoute_di" bpmnElement="Gateway_RiskRoute" isMarkerVisible="true">
        <dc:Bounds x="425" y="193" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="250" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AutoApprove_di" bpmnElement="Task_AutoApprove">
        <dc:Bounds x="560" y="60" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_UnderwriterReview_di" bpmnElement="Task_UnderwriterReview">
        <dc:Bounds x="560" y="178" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AutoReject_di" bpmnElement="Task_AutoReject">
        <dc:Bounds x="560" y="300" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved">
        <dc:Bounds x="742" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="720" y="125" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_Review_di" bpmnElement="End_Review">
        <dc:Bounds x="742" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="720" y="243" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="742" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="720" y="365" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToEvaluateRisk_di" bpmnElement="Flow_ToEvaluateRisk">
        <di:waypoint x="216" y="218" />
        <di:waypoint x="270" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToGateway_di" bpmnElement="Flow_ToGateway">
        <di:waypoint x="370" y="218" />
        <di:waypoint x="425" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Low_di" bpmnElement="Flow_Low">
        <di:waypoint x="450" y="193" />
        <di:waypoint x="450" y="100" />
        <di:waypoint x="560" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="460" y="80" width="30" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Medium_di" bpmnElement="Flow_Medium">
        <di:waypoint x="475" y="218" />
        <di:waypoint x="560" y="218" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="480" y="192" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_High_di" bpmnElement="Flow_High">
        <di:waypoint x="450" y="243" />
        <di:waypoint x="450" y="340" />
        <di:waypoint x="560" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="460" y="290" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEndApproved_di" bpmnElement="Flow_ToEndApproved">
        <di:waypoint x="670" y="100" />
        <di:waypoint x="742" y="100" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEndReview_di" bpmnElement="Flow_ToEndReview">
        <di:waypoint x="670" y="218" />
        <di:waypoint x="742" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEndRejected_di" bpmnElement="Flow_ToEndRejected">
        <di:waypoint x="670" y="340" />
        <di:waypoint x="742" y="340" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
