<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_OrderDiscount"
                   targetNamespace="http://camunda.org/schema/1.0/bpmn"
                   exporter="Claude" exporterVersion="1.0">

  <bpmn:process id="Process_OrderDiscountFulfillment" name="Multi-Item Order Discount &amp; Fulfillment" isExecutable="true">

    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>Flow_ToCalcDiscount</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:businessRuleTask id="Task_CalculateTotalDiscount" name="Calculate Total Discount"
        camunda:decisionRef="calculate-discounts"
        camunda:mapDecisionResult="singleEntry"
        camunda:resultVariable="totalDiscount">
      <bpmn:incoming>Flow_ToCalcDiscount</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCalcFinal</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:scriptTask id="Task_CalculateFinalAmount" name="Calculate Final Amount" scriptFormat="groovy">
      <bpmn:incoming>Flow_ToCalcFinal</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
      <bpmn:script>execution.setVariable("finalAmount", cartValue * (1 - (totalDiscount / 100)))</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="Gateway_AmountCheck" name="Final Amount &gt;= 1000?">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_NeedsSignoff</bpmn:outgoing>
      <bpmn:outgoing>Flow_DirectToWarehouse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ManagerSignoff" name="Manager Sign-off">
      <bpmn:incoming>Flow_NeedsSignoff</bpmn:incoming>
      <bpmn:outgoing>Flow_SignoffToWarehouse</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_SendOrderToWarehouse" name="Send Order to Warehouse"
        camunda:type="external" camunda:topic="send-order-to-warehouse">
      <bpmn:incoming>Flow_DirectToWarehouse</bpmn:incoming>
      <bpmn:incoming>Flow_SignoffToWarehouse</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_OrderFulfilled" name="Order Sent to Warehouse">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToCalcDiscount" sourceRef="StartEvent_OrderReceived" targetRef="Task_CalculateTotalDiscount" />
    <bpmn:sequenceFlow id="Flow_ToCalcFinal" sourceRef="Task_CalculateTotalDiscount" targetRef="Task_CalculateFinalAmount" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="Task_CalculateFinalAmount" targetRef="Gateway_AmountCheck" />

    <bpmn:sequenceFlow id="Flow_NeedsSignoff" name="finalAmount &gt;= 1000" sourceRef="Gateway_AmountCheck" targetRef="Task_ManagerSignoff">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="feel">finalAmount &gt;= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_DirectToWarehouse" name="finalAmount &lt; 1000" sourceRef="Gateway_AmountCheck" targetRef="Task_SendOrderToWarehouse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="feel">finalAmount &lt; 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_SignoffToWarehouse" sourceRef="Task_ManagerSignoff" targetRef="Task_SendOrderToWarehouse" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_SendOrderToWarehouse" targetRef="End_OrderFulfilled" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_OrderDiscountFulfillment">

      <bpmndi:BPMNShape id="StartEvent_OrderReceived_di" bpmnElement="StartEvent_OrderReceived">
        <dc:Bounds x="180" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="243" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CalculateTotalDiscount_di" bpmnElement="Task_CalculateTotalDiscount">
        <dc:Bounds x="270" y="178" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CalculateFinalAmount_di" bpmnElement="Task_CalculateFinalAmount">
        <dc:Bounds x="430" y="178" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_AmountCheck_di" bpmnElement="Gateway_AmountCheck" isMarkerVisible="true">
        <dc:Bounds x="595" y="193" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="575" y="250" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ManagerSignoff_di" bpmnElement="Task_ManagerSignoff">
        <dc:Bounds x="700" y="60" width="110" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendOrderToWarehouse_di" bpmnElement="Task_SendOrderToWarehouse">
        <dc:Bounds x="860" y="178" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_OrderFulfilled_di" bpmnElement="End_OrderFulfilled">
        <dc:Bounds x="1032" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1008" y="243" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToCalcDiscount_di" bpmnElement="Flow_ToCalcDiscount">
        <di:waypoint x="216" y="218" />
        <di:waypoint x="270" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToCalcFinal_di" bpmnElement="Flow_ToCalcFinal">
        <di:waypoint x="380" y="218" />
        <di:waypoint x="430" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToGateway_di" bpmnElement="Flow_ToGateway">
        <di:waypoint x="540" y="218" />
        <di:waypoint x="595" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_NeedsSignoff_di" bpmnElement="Flow_NeedsSignoff">
        <di:waypoint x="620" y="193" />
        <di:waypoint x="620" y="100" />
        <di:waypoint x="700" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="628" y="130" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_DirectToWarehouse_di" bpmnElement="Flow_DirectToWarehouse">
        <di:waypoint x="645" y="218" />
        <di:waypoint x="860" y="218" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="222" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_SignoffToWarehouse_di" bpmnElement="Flow_SignoffToWarehouse">
        <di:waypoint x="810" y="100" />
        <di:waypoint x="920" y="100" />
        <di:waypoint x="920" y="178" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="980" y="218" />
        <di:waypoint x="1032" y="218" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
