<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_A1" targetNamespace="https://example.edu/project-approval" exporter="Assignment 1 model" exporterVersion="1.0">
  <bpmn:error id="Error_Closed" name="Case must close" errorCode="CASE_CLOSED"/>
  <bpmn:error id="Error_Tech" name="Technical operation failed" errorCode="TECH_FAILURE"/>
  <bpmn:message id="Message_TeamWithdrawal" name="Team withdrawal request"/>
  <bpmn:message id="Message_GuideWithdrawal" name="Guide withdrawal before final confirmation"/>
  <bpmn:escalation id="Esc_Review" name="Review SLA breached" escalationCode="REVIEW_DELAY"/>
  <bpmn:process id="Process_A1" name="Student Project Approval and Allocation" isExecutable="false">
    <bpmn:laneSet id="Main_lanes">
      <bpmn:lane id="Main_lane0" name="Student / Team">
        <bpmn:flowNodeRef>Main_Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Main_lane1" name="Project Coordinator">
        <bpmn:flowNodeRef>Main_Run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_EndClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_WithdrawAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_EndWithdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Esc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Main_lane2" name="Review Committee / HoD">
        <bpmn:flowNodeRef>Main_Expedite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_EscEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Main_lane3" name="Faculty Guide"/>
      <bpmn:lane id="Main_lane4" name="Project Management System">
        <bpmn:flowNodeRef>Main_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_Undo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Main_Start" name="Team decides to submit">
      <bpmn:outgoing>Main_flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Main_Run" name="Run approval case&#10;(details: pages 2-8)">
      <bpmn:incoming>Main_flow1</bpmn:incoming>
      <bpmn:outgoing>Main_flow2</bpmn:outgoing>
      <bpmn:laneSet id="Case_lanes">
        <bpmn:lane id="Case_lane0" name="Student / Team">
          <bpmn:flowNodeRef>Case_Submit</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Case_lane1" name="Project Coordinator">
          <bpmn:flowNodeRef>Case_Screen</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Case_lane2" name="Review Committee / HoD">
          <bpmn:flowNodeRef>Case_Review</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Case_lane3" name="Faculty Guide"/>
        <bpmn:lane id="Case_lane4" name="Project Management System">
          <bpmn:flowNodeRef>Case_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Case_Validate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Case_Allocate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Case_Finalize</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Case_End</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Case_GuideWithdraw</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Case_Release</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Case_GuideWithdrawFinal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Case_Initialise</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Case_Start" name="Case opened">
        <bpmn:outgoing>Case_flow1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:subProcess id="Case_Submit" name="Submit proposal">
        <bpmn:incoming>Case_flow11</bpmn:incoming>
        <bpmn:outgoing>Case_flow2</bpmn:outgoing>
        <bpmn:laneSet id="Submit_lanes">
          <bpmn:lane id="Submit_lane0" name="Student / Team">
            <bpmn:flowNodeRef>Submit_Start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Submit_Form</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Submit_Deadline</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Submit_LateForm</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Submit_Expired</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Submit_lane1" name="Project Coordinator">
            <bpmn:flowNodeRef>Submit_Late</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Submit_LateOK</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Submit_lane2" name="Review Committee / HoD"/>
          <bpmn:lane id="Submit_lane3" name="Faculty Guide"/>
          <bpmn:lane id="Submit_lane4" name="Project Management System">
            <bpmn:flowNodeRef>Submit_End</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Submit_Lapsed</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="Submit_Start" name="Ready to submit">
          <bpmn:outgoing>Submit_flow1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:userTask id="Submit_Form" name="Complete and submit&#10;proposal + abstract">
          <bpmn:incoming>Submit_flow1</bpmn:incoming>
          <bpmn:outgoing>Submit_flow2</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="Submit_End" name="Proposal received">
          <bpmn:incoming>Submit_flow2</bpmn:incoming>
          <bpmn:incoming>Submit_flow7</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Submit_flow1" sourceRef="Submit_Start" targetRef="Submit_Form" name=""/>
        <bpmn:sequenceFlow id="Submit_flow2" sourceRef="Submit_Form" targetRef="Submit_End" name=""/>
        <bpmn:boundaryEvent id="Submit_Deadline" name="Submission deadline" attachedToRef="Submit_Form" cancelActivity="true">
          <bpmn:outgoing>Submit_flow3</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:userTask id="Submit_Late" name="Assess late request;&#10;set extended deadline">
          <bpmn:incoming>Submit_flow3</bpmn:incoming>
          <bpmn:outgoing>Submit_flow4</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:exclusiveGateway id="Submit_LateOK" name="Extension granted?" default="Submit_flow6">
          <bpmn:incoming>Submit_flow4</bpmn:incoming>
          <bpmn:outgoing>Submit_flow5</bpmn:outgoing>
          <bpmn:outgoing>Submit_flow6</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:userTask id="Submit_LateForm" name="Submit during&#10;one 3-day extension">
          <bpmn:incoming>Submit_flow5</bpmn:incoming>
          <bpmn:outgoing>Submit_flow7</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:boundaryEvent id="Submit_Expired" name="Extension expired" attachedToRef="Submit_LateForm" cancelActivity="true">
          <bpmn:outgoing>Submit_flow8</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:endEvent id="Submit_Lapsed" name="Lapsed: no submission">
          <bpmn:incoming>Submit_flow6</bpmn:incoming>
          <bpmn:incoming>Submit_flow8</bpmn:incoming>
          <bpmn:errorEventDefinition errorRef="Error_Closed"/>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Submit_flow3" sourceRef="Submit_Deadline" targetRef="Submit_Late" name=""/>
        <bpmn:sequenceFlow id="Submit_flow4" sourceRef="Submit_Late" targetRef="Submit_LateOK" name=""/>
        <bpmn:sequenceFlow id="Submit_flow5" sourceRef="Submit_LateOK" targetRef="Submit_LateForm" name="Yes">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">extensionGranted</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Submit_flow6" sourceRef="Submit_LateOK" targetRef="Submit_Lapsed" name="No"/>
        <bpmn:sequenceFlow id="Submit_flow7" sourceRef="Submit_LateForm" targetRef="Submit_End" name=""/>
        <bpmn:sequenceFlow id="Submit_flow8" sourceRef="Submit_Expired" targetRef="Submit_Lapsed" name=""/>
      </bpmn:subProcess>
      <bpmn:callActivity id="Case_Validate" name="Validate proposal" calledElement="Process_Validate">
        <bpmn:incoming>Case_flow2</bpmn:incoming>
        <bpmn:outgoing>Case_flow3</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:callActivity id="Case_Screen" name="Screen and check similarity" calledElement="Process_Screen">
        <bpmn:incoming>Case_flow3</bpmn:incoming>
        <bpmn:outgoing>Case_flow4</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:subProcess id="Case_Review" name="Committee review">
        <bpmn:incoming>Case_flow4</bpmn:incoming>
        <bpmn:outgoing>Case_flow5</bpmn:outgoing>
        <bpmn:laneSet id="Review_lanes">
          <bpmn:lane id="Review_lane0" name="Student / Team">
            <bpmn:flowNodeRef>Review_Revise</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_RevDue</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_NewTopic</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_NewDue</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Review_lane1" name="Project Coordinator">
            <bpmn:flowNodeRef>Review_NewAllowed</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_Remind</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_RemEnd</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_Rescreen</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Review_lane2" name="Review Committee / HoD">
            <bpmn:flowNodeRef>Review_Start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_Review</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_Decision</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_End</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_RevLimit</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_FinalDecision</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_FinalOK</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_Reminder</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_Escalate</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_ThrowEsc</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_EscEnd</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_HardDue</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_FinalDue</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Review_lane3" name="Faculty Guide"/>
          <bpmn:lane id="Review_lane4" name="Project Management System">
            <bpmn:flowNodeRef>Review_Closed</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Review_Revalidate</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="Review_Start" name="Screened proposal">
          <bpmn:outgoing>Review_flow1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:userTask id="Review_Review" name="Evaluate proposal; record&#10;quorum, conflicts and reasons">
          <bpmn:incoming>Review_flow1</bpmn:incoming>
          <bpmn:incoming>Review_flow24</bpmn:incoming>
          <bpmn:outgoing>Review_flow2</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:exclusiveGateway id="Review_Decision" name="Decision?" default="Review_flow5">
          <bpmn:incoming>Review_flow2</bpmn:incoming>
          <bpmn:outgoing>Review_flow3</bpmn:outgoing>
          <bpmn:outgoing>Review_flow4</bpmn:outgoing>
          <bpmn:outgoing>Review_flow5</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="Review_End" name="Approved">
          <bpmn:incoming>Review_flow3</bpmn:incoming>
          <bpmn:incoming>Review_flow11</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Review_flow1" sourceRef="Review_Start" targetRef="Review_Review" name=""/>
        <bpmn:sequenceFlow id="Review_flow2" sourceRef="Review_Review" targetRef="Review_Decision" name=""/>
        <bpmn:sequenceFlow id="Review_flow3" sourceRef="Review_Decision" targetRef="Review_End" name="Approve">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == approve</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:exclusiveGateway id="Review_RevLimit" name="Revision cycles &lt; 2?" default="Review_flow7">
          <bpmn:incoming>Review_flow4</bpmn:incoming>
          <bpmn:outgoing>Review_flow6</bpmn:outgoing>
          <bpmn:outgoing>Review_flow7</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:userTask id="Review_Revise" name="Revise proposal;&#10;revision count +1">
          <bpmn:incoming>Review_flow6</bpmn:incoming>
          <bpmn:outgoing>Review_flow8</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:boundaryEvent id="Review_RevDue" name="7 days" attachedToRef="Review_Revise" cancelActivity="true">
          <bpmn:outgoing>Review_flow9</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:userTask id="Review_FinalDecision" name="Committee final decision&#10;(approve or reject only)">
          <bpmn:incoming>Review_flow7</bpmn:incoming>
          <bpmn:outgoing>Review_flow10</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:exclusiveGateway id="Review_FinalOK" name="Approved?" default="Review_flow12">
          <bpmn:incoming>Review_flow10</bpmn:incoming>
          <bpmn:outgoing>Review_flow11</bpmn:outgoing>
          <bpmn:outgoing>Review_flow12</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="Review_NewAllowed" name="New topic used &lt; 1?" default="Review_flow14">
          <bpmn:incoming>Review_flow5</bpmn:incoming>
          <bpmn:incoming>Review_flow12</bpmn:incoming>
          <bpmn:outgoing>Review_flow13</bpmn:outgoing>
          <bpmn:outgoing>Review_flow14</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:userTask id="Review_NewTopic" name="Submit one new topic;&#10;newTopicUsed = 1">
          <bpmn:incoming>Review_flow13</bpmn:incoming>
          <bpmn:outgoing>Review_flow15</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:boundaryEvent id="Review_NewDue" name="7 days" attachedToRef="Review_NewTopic" cancelActivity="true">
          <bpmn:outgoing>Review_flow16</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:endEvent id="Review_Closed" name="Rejected / lapsed:&#10;review not completed">
          <bpmn:incoming>Review_flow9</bpmn:incoming>
          <bpmn:incoming>Review_flow14</bpmn:incoming>
          <bpmn:incoming>Review_flow16</bpmn:incoming>
          <bpmn:incoming>Review_flow21</bpmn:incoming>
          <bpmn:incoming>Review_flow22</bpmn:incoming>
          <bpmn:errorEventDefinition errorRef="Error_Closed"/>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Review_flow4" sourceRef="Review_Decision" targetRef="Review_RevLimit" name="Revise">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == revise</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Review_flow5" sourceRef="Review_Decision" targetRef="Review_NewAllowed" name="Reject"/>
        <bpmn:sequenceFlow id="Review_flow6" sourceRef="Review_RevLimit" targetRef="Review_Revise" name="Yes">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">revisionCycles &lt; 2</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Review_flow7" sourceRef="Review_RevLimit" targetRef="Review_FinalDecision" name="No"/>
        <bpmn:sequenceFlow id="Review_flow8" sourceRef="Review_Revise" targetRef="Review_Revalidate" name="Changed proposal"/>
        <bpmn:sequenceFlow id="Review_flow9" sourceRef="Review_RevDue" targetRef="Review_Closed" name=""/>
        <bpmn:sequenceFlow id="Review_flow10" sourceRef="Review_FinalDecision" targetRef="Review_FinalOK" name=""/>
        <bpmn:sequenceFlow id="Review_flow11" sourceRef="Review_FinalOK" targetRef="Review_End" name="Yes">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Review_flow12" sourceRef="Review_FinalOK" targetRef="Review_NewAllowed" name="No"/>
        <bpmn:sequenceFlow id="Review_flow13" sourceRef="Review_NewAllowed" targetRef="Review_NewTopic" name="Yes">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">newTopicUsed &lt; 1</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Review_flow14" sourceRef="Review_NewAllowed" targetRef="Review_Closed" name="No"/>
        <bpmn:sequenceFlow id="Review_flow15" sourceRef="Review_NewTopic" targetRef="Review_Revalidate" name="Changed proposal"/>
        <bpmn:sequenceFlow id="Review_flow16" sourceRef="Review_NewDue" targetRef="Review_Closed" name=""/>
        <bpmn:boundaryEvent id="Review_Reminder" name="3-day reminder" attachedToRef="Review_Review" cancelActivity="false">
          <bpmn:outgoing>Review_flow17</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:userTask id="Review_Remind" name="Send reviewer reminder&#10;(portal fallback)">
          <bpmn:incoming>Review_flow17</bpmn:incoming>
          <bpmn:outgoing>Review_flow18</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="Review_RemEnd" name="Reminder sent">
          <bpmn:incoming>Review_flow18</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Review_flow17" sourceRef="Review_Reminder" targetRef="Review_Remind" name=""/>
        <bpmn:sequenceFlow id="Review_flow18" sourceRef="Review_Remind" targetRef="Review_RemEnd" name=""/>
        <bpmn:boundaryEvent id="Review_Escalate" name="5-day escalation" attachedToRef="Review_Review" cancelActivity="false">
          <bpmn:outgoing>Review_flow19</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:intermediateThrowEvent id="Review_ThrowEsc" name="Raise review escalation">
          <bpmn:incoming>Review_flow19</bpmn:incoming>
          <bpmn:outgoing>Review_flow20</bpmn:outgoing>
          <bpmn:escalationEventDefinition escalationRef="Esc_Review"/>
        </bpmn:intermediateThrowEvent>
        <bpmn:endEvent id="Review_EscEnd" name="Review remains active">
          <bpmn:incoming>Review_flow20</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Review_flow19" sourceRef="Review_Escalate" targetRef="Review_ThrowEsc" name=""/>
        <bpmn:sequenceFlow id="Review_flow20" sourceRef="Review_ThrowEsc" targetRef="Review_EscEnd" name=""/>
        <bpmn:boundaryEvent id="Review_HardDue" name="10-day hard limit" attachedToRef="Review_Review" cancelActivity="true">
          <bpmn:outgoing>Review_flow21</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Review_flow21" sourceRef="Review_HardDue" targetRef="Review_Closed" name=""/>
        <bpmn:boundaryEvent id="Review_FinalDue" name="5 days" attachedToRef="Review_FinalDecision" cancelActivity="true">
          <bpmn:outgoing>Review_flow22</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Review_flow22" sourceRef="Review_FinalDue" targetRef="Review_Closed" name=""/>
        <bpmn:callActivity id="Review_Revalidate" name="Revalidate changed proposal" calledElement="Process_Validate">
          <bpmn:incoming>Review_flow8</bpmn:incoming>
          <bpmn:incoming>Review_flow15</bpmn:incoming>
          <bpmn:outgoing>Review_flow23</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:callActivity id="Review_Rescreen" name="Rescreen + similarity check" calledElement="Process_Screen">
          <bpmn:incoming>Review_flow23</bpmn:incoming>
          <bpmn:outgoing>Review_flow24</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:sequenceFlow id="Review_flow23" sourceRef="Review_Revalidate" targetRef="Review_Rescreen" name=""/>
        <bpmn:sequenceFlow id="Review_flow24" sourceRef="Review_Rescreen" targetRef="Review_Review" name="Rechecked proposal"/>
      </bpmn:subProcess>
      <bpmn:subProcess id="Case_Allocate" name="Allocate and confirm guide">
        <bpmn:incoming>Case_flow5</bpmn:incoming>
        <bpmn:incoming>Case_flow9</bpmn:incoming>
        <bpmn:outgoing>Case_flow6</bpmn:outgoing>
        <bpmn:laneSet id="Allocate_lanes">
          <bpmn:lane id="Allocate_lane0" name="Student / Team"/>
          <bpmn:lane id="Allocate_lane1" name="Project Coordinator">
            <bpmn:flowNodeRef>Allocate_Manual</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_WaitDue</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Selected</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Release</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Reconcile</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Contact</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_ManualAcceptDue</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Allocate_lane2" name="Review Committee / HoD"/>
          <bpmn:lane id="Allocate_lane3" name="Faculty Guide">
            <bpmn:flowNodeRef>Allocate_Accept</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_NoReply</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Accepted</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Allocate_lane4" name="Project Management System">
            <bpmn:flowNodeRef>Allocate_Start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Rule</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Available</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Lapsed</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Reserve</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Send</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_End</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Undo</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Exclude</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Comp</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_RuleError</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_Conflict</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Allocate_SendError</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="Allocate_Start" name="Approved proposal">
          <bpmn:outgoing>Allocate_flow1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:businessRuleTask id="Allocate_Rule" name="Rank domain-matched guides&#10;by capacity and conflicts">
          <bpmn:incoming>Allocate_flow1</bpmn:incoming>
          <bpmn:incoming>Allocate_flow16</bpmn:incoming>
          <bpmn:incoming>Allocate_flow19</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow2</bpmn:outgoing>
        </bpmn:businessRuleTask>
        <bpmn:exclusiveGateway id="Allocate_Available" name="Candidate available&#10;and attempts &lt; 3?" default="Allocate_flow4">
          <bpmn:incoming>Allocate_flow2</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow3</bpmn:outgoing>
          <bpmn:outgoing>Allocate_flow4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:userTask id="Allocate_Manual" name="Choose co-guide / external&#10;guide or waitlist (14 days)">
          <bpmn:incoming>Allocate_flow4</bpmn:incoming>
          <bpmn:incoming>Allocate_flow17</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow5</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:boundaryEvent id="Allocate_WaitDue" name="14 days" attachedToRef="Allocate_Manual" cancelActivity="true">
          <bpmn:outgoing>Allocate_flow8</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:exclusiveGateway id="Allocate_Selected" name="Guide found?" default="Allocate_flow7">
          <bpmn:incoming>Allocate_flow5</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow6</bpmn:outgoing>
          <bpmn:outgoing>Allocate_flow7</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="Allocate_Lapsed" name="Lapsed: no guide">
          <bpmn:incoming>Allocate_flow7</bpmn:incoming>
          <bpmn:incoming>Allocate_flow8</bpmn:incoming>
          <bpmn:errorEventDefinition errorRef="Error_Closed"/>
        </bpmn:endEvent>
        <bpmn:serviceTask id="Allocate_Reserve" name="Atomically reserve slot&#10;(case-key idempotent)">
          <bpmn:incoming>Allocate_flow3</bpmn:incoming>
          <bpmn:incoming>Allocate_flow6</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow9</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sendTask id="Allocate_Send" name="Send allocation request&#10;(portal durable outbox)">
          <bpmn:incoming>Allocate_flow9</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow10</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:userTask id="Allocate_Accept" name="Guide accepts or declines;&#10;record formal response">
          <bpmn:incoming>Allocate_flow10</bpmn:incoming>
          <bpmn:incoming>Allocate_flow21</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow11</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:boundaryEvent id="Allocate_NoReply" name="3 days" attachedToRef="Allocate_Accept" cancelActivity="true">
          <bpmn:outgoing>Allocate_flow14</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:exclusiveGateway id="Allocate_Accepted" name="Accepted?" default="Allocate_flow13">
          <bpmn:incoming>Allocate_flow11</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow12</bpmn:outgoing>
          <bpmn:outgoing>Allocate_flow13</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="Allocate_End" name="Guide accepted;&#10;hold retained">
          <bpmn:incoming>Allocate_flow12</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:intermediateThrowEvent id="Allocate_Undo" name="Compensate reservation">
          <bpmn:incoming>Allocate_flow13</bpmn:incoming>
          <bpmn:incoming>Allocate_flow14</bpmn:incoming>
          <bpmn:incoming>Allocate_flow22</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow15</bpmn:outgoing>
          <bpmn:compensateEventDefinition activityRef="Allocate_Reserve"/>
        </bpmn:intermediateThrowEvent>
        <bpmn:serviceTask id="Allocate_Exclude" name="Exclude guide; increment&#10;attempts; clear request">
          <bpmn:incoming>Allocate_flow15</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow16</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:boundaryEvent id="Allocate_Comp" name="Compensation handler" attachedToRef="Allocate_Reserve" cancelActivity="true">
          <bpmn:compensateEventDefinition/>
        </bpmn:boundaryEvent>
        <bpmn:serviceTask id="Allocate_Release" name="Release reserved slot&#10;(idempotent)" isForCompensation="true"/>
        <bpmn:sequenceFlow id="Allocate_flow1" sourceRef="Allocate_Start" targetRef="Allocate_Rule" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow2" sourceRef="Allocate_Rule" targetRef="Allocate_Available" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow3" sourceRef="Allocate_Available" targetRef="Allocate_Reserve" name="Yes">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidateExists and guideAttempts &lt; 3</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Allocate_flow4" sourceRef="Allocate_Available" targetRef="Allocate_Manual" name="No"/>
        <bpmn:sequenceFlow id="Allocate_flow5" sourceRef="Allocate_Manual" targetRef="Allocate_Selected" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow6" sourceRef="Allocate_Selected" targetRef="Allocate_Reserve" name="Yes">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">manualGuideFound</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Allocate_flow7" sourceRef="Allocate_Selected" targetRef="Allocate_Lapsed" name="No"/>
        <bpmn:sequenceFlow id="Allocate_flow8" sourceRef="Allocate_WaitDue" targetRef="Allocate_Lapsed" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow9" sourceRef="Allocate_Reserve" targetRef="Allocate_Send" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow10" sourceRef="Allocate_Send" targetRef="Allocate_Accept" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow11" sourceRef="Allocate_Accept" targetRef="Allocate_Accepted" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow12" sourceRef="Allocate_Accepted" targetRef="Allocate_End" name="Yes">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">guideAccepted</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Allocate_flow13" sourceRef="Allocate_Accepted" targetRef="Allocate_Undo" name="No"/>
        <bpmn:sequenceFlow id="Allocate_flow14" sourceRef="Allocate_NoReply" targetRef="Allocate_Undo" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow15" sourceRef="Allocate_Undo" targetRef="Allocate_Exclude" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow16" sourceRef="Allocate_Exclude" targetRef="Allocate_Rule" name="Next candidate"/>
        <bpmn:boundaryEvent id="Allocate_RuleError" name="Rule service failed" attachedToRef="Allocate_Rule" cancelActivity="true">
          <bpmn:outgoing>Allocate_flow17</bpmn:outgoing>
          <bpmn:errorEventDefinition errorRef="Error_Tech"/>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Allocate_flow17" sourceRef="Allocate_RuleError" targetRef="Allocate_Manual" name=""/>
        <bpmn:boundaryEvent id="Allocate_Conflict" name="Capacity race / DB error" attachedToRef="Allocate_Reserve" cancelActivity="true">
          <bpmn:outgoing>Allocate_flow18</bpmn:outgoing>
          <bpmn:errorEventDefinition errorRef="Error_Tech"/>
        </bpmn:boundaryEvent>
        <bpmn:userTask id="Allocate_Reconcile" name="Reconcile uncertain hold;&#10;release if present; attempts +1">
          <bpmn:incoming>Allocate_flow18</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow19</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Allocate_flow18" sourceRef="Allocate_Conflict" targetRef="Allocate_Reconcile" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow19" sourceRef="Allocate_Reconcile" targetRef="Allocate_Rule" name="Recheck"/>
        <bpmn:boundaryEvent id="Allocate_SendError" name="Delivery error" attachedToRef="Allocate_Send" cancelActivity="true">
          <bpmn:outgoing>Allocate_flow20</bpmn:outgoing>
          <bpmn:errorEventDefinition errorRef="Error_Tech"/>
        </bpmn:boundaryEvent>
        <bpmn:userTask id="Allocate_Contact" name="Coordinator contacts guide;&#10;logs request in portal">
          <bpmn:incoming>Allocate_flow20</bpmn:incoming>
          <bpmn:outgoing>Allocate_flow21</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Allocate_flow20" sourceRef="Allocate_SendError" targetRef="Allocate_Contact" name=""/>
        <bpmn:sequenceFlow id="Allocate_flow21" sourceRef="Allocate_Contact" targetRef="Allocate_Accept" name=""/>
        <bpmn:boundaryEvent id="Allocate_ManualAcceptDue" name="3 days" attachedToRef="Allocate_Contact" cancelActivity="true">
          <bpmn:outgoing>Allocate_flow22</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Allocate_flow22" sourceRef="Allocate_ManualAcceptDue" targetRef="Allocate_Undo" name=""/>
        <bpmn:association id="Allocate_assoc0" sourceRef="Allocate_Comp" targetRef="Allocate_Release" associationDirection="One"/>
      </bpmn:subProcess>
      <bpmn:subProcess id="Case_Finalize" name="Record and notify">
        <bpmn:incoming>Case_flow6</bpmn:incoming>
        <bpmn:outgoing>Case_flow7</bpmn:outgoing>
        <bpmn:laneSet id="Finalize_lanes">
          <bpmn:lane id="Finalize_lane0" name="Student / Team">
            <bpmn:flowNodeRef>Finalize_NoticeWait</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_Lapsed</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Finalize_lane1" name="Project Coordinator">
            <bpmn:flowNodeRef>Finalize_Retry</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_Wait</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_ManualRecord</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_NoticeRetry</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_ManualNotify</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_ManualArchive</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_ContactDue</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Finalize_lane2" name="Review Committee / HoD"/>
          <bpmn:lane id="Finalize_lane3" name="Faculty Guide"/>
          <bpmn:lane id="Finalize_lane4" name="Project Management System">
            <bpmn:flowNodeRef>Finalize_Start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_Record</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_Split</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_Notify</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_Archive</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_Join</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_End</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_DBError</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_NotifyError</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_ArchiveError</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_Release</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_RecordMerge</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_NoticeMerge</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Finalize_ArchiveMerge</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="Finalize_Start" name="Guide accepted">
          <bpmn:outgoing>Finalize_flow1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Finalize_Record" name="Commit confirmed allocation&#10;and audit (idempotent)">
          <bpmn:incoming>Finalize_flow1</bpmn:incoming>
          <bpmn:incoming>Finalize_flow10</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:parallelGateway id="Finalize_Split" name="Both required">
          <bpmn:incoming>Finalize_flow22</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow3</bpmn:outgoing>
          <bpmn:outgoing>Finalize_flow4</bpmn:outgoing>
        </bpmn:parallelGateway>
        <bpmn:sendTask id="Finalize_Notify" name="Notify student;&#10;log delivery evidence">
          <bpmn:incoming>Finalize_flow3</bpmn:incoming>
          <bpmn:incoming>Finalize_flow15</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow5</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:serviceTask id="Finalize_Archive" name="Archive approved proposal&#10;and acceptance evidence">
          <bpmn:incoming>Finalize_flow4</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow6</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:parallelGateway id="Finalize_Join" name="Both complete">
          <bpmn:incoming>Finalize_flow23</bpmn:incoming>
          <bpmn:incoming>Finalize_flow24</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow7</bpmn:outgoing>
        </bpmn:parallelGateway>
        <bpmn:endEvent id="Finalize_End" name="Recorded and notified">
          <bpmn:incoming>Finalize_flow7</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Finalize_flow1" sourceRef="Finalize_Start" targetRef="Finalize_Record" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow2" sourceRef="Finalize_Record" targetRef="Finalize_RecordMerge" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow3" sourceRef="Finalize_Split" targetRef="Finalize_Notify" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow4" sourceRef="Finalize_Split" targetRef="Finalize_Archive" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow5" sourceRef="Finalize_Notify" targetRef="Finalize_NoticeMerge" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow6" sourceRef="Finalize_Archive" targetRef="Finalize_ArchiveMerge" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow7" sourceRef="Finalize_Join" targetRef="Finalize_End" name=""/>
        <bpmn:boundaryEvent id="Finalize_DBError" name="Database error" attachedToRef="Finalize_Record" cancelActivity="true">
          <bpmn:outgoing>Finalize_flow8</bpmn:outgoing>
          <bpmn:errorEventDefinition errorRef="Error_Tech"/>
        </bpmn:boundaryEvent>
        <bpmn:exclusiveGateway id="Finalize_Retry" name="DB attempts &lt; 3?&#10;increment on error" default="Finalize_flow11">
          <bpmn:incoming>Finalize_flow8</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow9</bpmn:outgoing>
          <bpmn:outgoing>Finalize_flow11</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:intermediateCatchEvent id="Finalize_Wait" name="Wait 5 minutes">
          <bpmn:incoming>Finalize_flow9</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow10</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:userTask id="Finalize_ManualRecord" name="Commit signed allocation&#10;in controlled manual register">
          <bpmn:incoming>Finalize_flow11</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow12</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Finalize_flow8" sourceRef="Finalize_DBError" targetRef="Finalize_Retry" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow9" sourceRef="Finalize_Retry" targetRef="Finalize_Wait" name="Yes">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">dbAttempts &lt; 3</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Finalize_flow10" sourceRef="Finalize_Wait" targetRef="Finalize_Record" name="Retry"/>
        <bpmn:sequenceFlow id="Finalize_flow11" sourceRef="Finalize_Retry" targetRef="Finalize_ManualRecord" name="No"/>
        <bpmn:sequenceFlow id="Finalize_flow12" sourceRef="Finalize_ManualRecord" targetRef="Finalize_RecordMerge" name=""/>
        <bpmn:boundaryEvent id="Finalize_NotifyError" name="Delivery failure" attachedToRef="Finalize_Notify" cancelActivity="true">
          <bpmn:outgoing>Finalize_flow13</bpmn:outgoing>
          <bpmn:errorEventDefinition errorRef="Error_Tech"/>
        </bpmn:boundaryEvent>
        <bpmn:exclusiveGateway id="Finalize_NoticeRetry" name="Notice attempts &lt; 3?&#10;increment on error" default="Finalize_flow16">
          <bpmn:incoming>Finalize_flow13</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow14</bpmn:outgoing>
          <bpmn:outgoing>Finalize_flow16</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:userTask id="Finalize_ManualNotify" name="Notify via verified phone /&#10;portal; log receipt">
          <bpmn:incoming>Finalize_flow16</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow17</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:intermediateCatchEvent id="Finalize_NoticeWait" name="Wait 5 minutes">
          <bpmn:incoming>Finalize_flow14</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow15</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:sequenceFlow id="Finalize_flow13" sourceRef="Finalize_NotifyError" targetRef="Finalize_NoticeRetry" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow14" sourceRef="Finalize_NoticeRetry" targetRef="Finalize_NoticeWait" name="Yes">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">noticeAttempts &lt; 3</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Finalize_flow15" sourceRef="Finalize_NoticeWait" targetRef="Finalize_Notify" name="Retry"/>
        <bpmn:sequenceFlow id="Finalize_flow16" sourceRef="Finalize_NoticeRetry" targetRef="Finalize_ManualNotify" name="No"/>
        <bpmn:sequenceFlow id="Finalize_flow17" sourceRef="Finalize_ManualNotify" targetRef="Finalize_NoticeMerge" name=""/>
        <bpmn:boundaryEvent id="Finalize_ArchiveError" name="Archive failure" attachedToRef="Finalize_Archive" cancelActivity="true">
          <bpmn:outgoing>Finalize_flow18</bpmn:outgoing>
          <bpmn:errorEventDefinition errorRef="Error_Tech"/>
        </bpmn:boundaryEvent>
        <bpmn:userTask id="Finalize_ManualArchive" name="Save signed evidence&#10;to controlled register">
          <bpmn:incoming>Finalize_flow18</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow19</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Finalize_flow18" sourceRef="Finalize_ArchiveError" targetRef="Finalize_ManualArchive" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow19" sourceRef="Finalize_ManualArchive" targetRef="Finalize_ArchiveMerge" name=""/>
        <bpmn:boundaryEvent id="Finalize_ContactDue" name="7 days: unreachable" attachedToRef="Finalize_ManualNotify" cancelActivity="true">
          <bpmn:outgoing>Finalize_flow20</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:endEvent id="Finalize_Lapsed" name="Lapsed: notification&#10;not completed">
          <bpmn:incoming>Finalize_flow21</bpmn:incoming>
          <bpmn:errorEventDefinition errorRef="Error_Closed"/>
        </bpmn:endEvent>
        <bpmn:serviceTask id="Finalize_Release" name="Release guide hold;&#10;void confirmed record">
          <bpmn:incoming>Finalize_flow20</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow21</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Finalize_flow20" sourceRef="Finalize_ContactDue" targetRef="Finalize_Release" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow21" sourceRef="Finalize_Release" targetRef="Finalize_Lapsed" name=""/>
        <bpmn:exclusiveGateway id="Finalize_RecordMerge" name="Recorded">
          <bpmn:incoming>Finalize_flow2</bpmn:incoming>
          <bpmn:incoming>Finalize_flow12</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow22</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="Finalize_NoticeMerge" name="Notified">
          <bpmn:incoming>Finalize_flow5</bpmn:incoming>
          <bpmn:incoming>Finalize_flow17</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow23</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="Finalize_ArchiveMerge" name="Archived">
          <bpmn:incoming>Finalize_flow6</bpmn:incoming>
          <bpmn:incoming>Finalize_flow19</bpmn:incoming>
          <bpmn:outgoing>Finalize_flow24</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Finalize_flow22" sourceRef="Finalize_RecordMerge" targetRef="Finalize_Split" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow23" sourceRef="Finalize_NoticeMerge" targetRef="Finalize_Join" name=""/>
        <bpmn:sequenceFlow id="Finalize_flow24" sourceRef="Finalize_ArchiveMerge" targetRef="Finalize_Join" name=""/>
      </bpmn:subProcess>
      <bpmn:endEvent id="Case_End" name="Case completed">
        <bpmn:incoming>Case_flow7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Case_flow1" sourceRef="Case_Start" targetRef="Case_Initialise" name=""/>
      <bpmn:sequenceFlow id="Case_flow2" sourceRef="Case_Submit" targetRef="Case_Validate" name=""/>
      <bpmn:sequenceFlow id="Case_flow3" sourceRef="Case_Validate" targetRef="Case_Screen" name=""/>
      <bpmn:sequenceFlow id="Case_flow4" sourceRef="Case_Screen" targetRef="Case_Review" name=""/>
      <bpmn:sequenceFlow id="Case_flow5" sourceRef="Case_Review" targetRef="Case_Allocate" name=""/>
      <bpmn:sequenceFlow id="Case_flow6" sourceRef="Case_Allocate" targetRef="Case_Finalize" name=""/>
      <bpmn:sequenceFlow id="Case_flow7" sourceRef="Case_Finalize" targetRef="Case_End" name=""/>
      <bpmn:boundaryEvent id="Case_GuideWithdraw" name="Guide withdraws" attachedToRef="Case_Allocate" cancelActivity="true">
        <bpmn:outgoing>Case_flow8</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_GuideWithdrawal"/>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="Case_Release" name="Release hold; exclude guide;&#10;increment guide attempts">
        <bpmn:documentation>Idempotently release the reserved or confirmed guide slot, void any provisional confirmation, clear acceptance evidence, exclude the guide and increment guideAttempts before reallocation.</bpmn:documentation>
        <bpmn:incoming>Case_flow8</bpmn:incoming>
        <bpmn:incoming>Case_flow10</bpmn:incoming>
        <bpmn:outgoing>Case_flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Case_flow8" sourceRef="Case_GuideWithdraw" targetRef="Case_Release" name=""/>
      <bpmn:sequenceFlow id="Case_flow9" sourceRef="Case_Release" targetRef="Case_Allocate" name="Reassign"/>
      <bpmn:boundaryEvent id="Case_GuideWithdrawFinal" name="Guide withdraws" attachedToRef="Case_Finalize" cancelActivity="true">
        <bpmn:outgoing>Case_flow10</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_GuideWithdrawal"/>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Case_flow10" sourceRef="Case_GuideWithdrawFinal" targetRef="Case_Release" name="Undo confirmation; reassign"/>
      <bpmn:scriptTask id="Case_Initialise" name="Initialise case counters&#10;and audit context" scriptFormat="text/plain">
        <bpmn:incoming>Case_flow1</bpmn:incoming>
        <bpmn:outgoing>Case_flow11</bpmn:outgoing>
        <bpmn:script>Set corrections, topicChanges, revisionCycles, newTopicUsed, guideAttempts and operation-specific failure counts to zero; initialise excluded guides and case audit context.</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Case_flow11" sourceRef="Case_Initialise" targetRef="Case_Submit" name=""/>
    </bpmn:subProcess>
    <bpmn:endEvent id="Main_Success" name="Project allocated&#10;and student notified">
      <bpmn:incoming>Main_flow2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Main_flow1" sourceRef="Main_Start" targetRef="Main_Run" name=""/>
    <bpmn:sequenceFlow id="Main_flow2" sourceRef="Main_Run" targetRef="Main_Success" name=""/>
    <bpmn:boundaryEvent id="Main_Closed" name="CASE_CLOSED" attachedToRef="Main_Run" cancelActivity="true">
      <bpmn:outgoing>Main_flow3</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Closed"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Main_Close" name="Record rejection / lapse&#10;with reason and audit">
      <bpmn:incoming>Main_flow3</bpmn:incoming>
      <bpmn:outgoing>Main_flow4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Main_Notice" name="Deliver closure reasons&#10;(portal / phone fallback)">
      <bpmn:incoming>Main_flow4</bpmn:incoming>
      <bpmn:outgoing>Main_flow5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Main_EndClosed" name="Rejected / lapsed">
      <bpmn:incoming>Main_flow5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Main_flow3" sourceRef="Main_Closed" targetRef="Main_Close" name=""/>
    <bpmn:sequenceFlow id="Main_flow4" sourceRef="Main_Close" targetRef="Main_Notice" name=""/>
    <bpmn:sequenceFlow id="Main_flow5" sourceRef="Main_Notice" targetRef="Main_EndClosed" name=""/>
    <bpmn:boundaryEvent id="Main_Withdraw" name="Team withdraws" attachedToRef="Main_Run" cancelActivity="true">
      <bpmn:outgoing>Main_flow6</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_TeamWithdrawal"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Main_Undo" name="Release any guide hold;&#10;void pending records">
      <bpmn:incoming>Main_flow6</bpmn:incoming>
      <bpmn:outgoing>Main_flow7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Main_WithdrawAudit" name="Record withdrawal;&#10;confirm to team">
      <bpmn:incoming>Main_flow7</bpmn:incoming>
      <bpmn:outgoing>Main_flow8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Main_EndWithdraw" name="Closed as withdrawn">
      <bpmn:incoming>Main_flow8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Main_flow6" sourceRef="Main_Withdraw" targetRef="Main_Undo" name=""/>
    <bpmn:sequenceFlow id="Main_flow7" sourceRef="Main_Undo" targetRef="Main_WithdrawAudit" name=""/>
    <bpmn:sequenceFlow id="Main_flow8" sourceRef="Main_WithdrawAudit" targetRef="Main_EndWithdraw" name=""/>
    <bpmn:boundaryEvent id="Main_Esc" name="Review delay" attachedToRef="Main_Run" cancelActivity="false">
      <bpmn:outgoing>Main_flow9</bpmn:outgoing>
      <bpmn:escalationEventDefinition escalationRef="Esc_Review"/>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Main_Expedite" name="HoD assigns replacement&#10;reviewers / prioritises">
      <bpmn:incoming>Main_flow9</bpmn:incoming>
      <bpmn:outgoing>Main_flow10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Main_EscEnd" name="Escalation handled;&#10;review continues">
      <bpmn:incoming>Main_flow10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Main_flow9" sourceRef="Main_Esc" targetRef="Main_Expedite" name=""/>
    <bpmn:sequenceFlow id="Main_flow10" sourceRef="Main_Expedite" targetRef="Main_EscEnd" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_Validate" name="Validate proposal (reusable)" isExecutable="false">
    <bpmn:laneSet id="Validate_lanes">
      <bpmn:lane id="Validate_lane0" name="Student / Team">
        <bpmn:flowNodeRef>Validate_Correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_CorrectionDue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Validate_lane1" name="Project Coordinator">
        <bpmn:flowNodeRef>Validate_Limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_Exception</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_Manual</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Validate_lane2" name="Review Committee / HoD"/>
      <bpmn:lane id="Validate_lane3" name="Faculty Guide"/>
      <bpmn:lane id="Validate_lane4" name="Project Management System">
        <bpmn:flowNodeRef>Validate_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_Invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_Wait</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Validate_Start" name="Proposal received">
      <bpmn:outgoing>Validate_flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Validate_Check" name="Validate fields, files,&#10;team rules and identity">
      <bpmn:incoming>Validate_flow1</bpmn:incoming>
      <bpmn:incoming>Validate_flow8</bpmn:incoming>
      <bpmn:incoming>Validate_flow11</bpmn:incoming>
      <bpmn:incoming>Validate_flow15</bpmn:incoming>
      <bpmn:outgoing>Validate_flow2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Validate_Result" name="Validation result?" default="Validate_flow5">
      <bpmn:incoming>Validate_flow2</bpmn:incoming>
      <bpmn:incoming>Validate_flow17</bpmn:incoming>
      <bpmn:outgoing>Validate_flow3</bpmn:outgoing>
      <bpmn:outgoing>Validate_flow4</bpmn:outgoing>
      <bpmn:outgoing>Validate_flow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Validate_End" name="Valid proposal">
      <bpmn:incoming>Validate_flow3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Validate_flow1" sourceRef="Validate_Start" targetRef="Validate_Check" name=""/>
    <bpmn:sequenceFlow id="Validate_flow2" sourceRef="Validate_Check" targetRef="Validate_Result" name=""/>
    <bpmn:sequenceFlow id="Validate_flow3" sourceRef="Validate_Result" targetRef="Validate_End" name="Valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validation == valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Validate_Correct" name="Correct listed errors&#10;(count +1; 7 days)">
      <bpmn:incoming>Validate_flow6</bpmn:incoming>
      <bpmn:outgoing>Validate_flow8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Validate_CorrectionDue" name="7 days" attachedToRef="Validate_Correct" cancelActivity="true">
      <bpmn:outgoing>Validate_flow9</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Validate_Limit" name="Corrections &lt; 2?" default="Validate_flow7">
      <bpmn:incoming>Validate_flow4</bpmn:incoming>
      <bpmn:outgoing>Validate_flow6</bpmn:outgoing>
      <bpmn:outgoing>Validate_flow7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Validate_Exception" name="Resolve persistent data&#10;errors or close case">
      <bpmn:incoming>Validate_flow7</bpmn:incoming>
      <bpmn:outgoing>Validate_flow10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Validate_Resolved" name="Resolved?" default="Validate_flow12">
      <bpmn:incoming>Validate_flow10</bpmn:incoming>
      <bpmn:outgoing>Validate_flow11</bpmn:outgoing>
      <bpmn:outgoing>Validate_flow12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Validate_Invalid" name="Rejected: invalid team&#10;or unresolved data">
      <bpmn:incoming>Validate_flow5</bpmn:incoming>
      <bpmn:incoming>Validate_flow9</bpmn:incoming>
      <bpmn:incoming>Validate_flow12</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_Closed"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Validate_flow4" sourceRef="Validate_Result" targetRef="Validate_Limit" name="Missing / unreadable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validation == correctable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Validate_flow5" sourceRef="Validate_Result" targetRef="Validate_Invalid" name="Invalid team / identity"/>
    <bpmn:sequenceFlow id="Validate_flow6" sourceRef="Validate_Limit" targetRef="Validate_Correct" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">corrections &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Validate_flow7" sourceRef="Validate_Limit" targetRef="Validate_Exception" name="No"/>
    <bpmn:sequenceFlow id="Validate_flow8" sourceRef="Validate_Correct" targetRef="Validate_Check" name="Resubmit"/>
    <bpmn:sequenceFlow id="Validate_flow9" sourceRef="Validate_CorrectionDue" targetRef="Validate_Invalid" name=""/>
    <bpmn:sequenceFlow id="Validate_flow10" sourceRef="Validate_Exception" targetRef="Validate_Resolved" name=""/>
    <bpmn:sequenceFlow id="Validate_flow11" sourceRef="Validate_Resolved" targetRef="Validate_Check" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">dataResolved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Validate_flow12" sourceRef="Validate_Resolved" targetRef="Validate_Invalid" name="No"/>
    <bpmn:boundaryEvent id="Validate_Error" name="Technical error" attachedToRef="Validate_Check" cancelActivity="true">
      <bpmn:outgoing>Validate_flow13</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Tech"/>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Validate_Retry" name="Attempts &lt; 3?&#10;(increment on failure)" default="Validate_flow16">
      <bpmn:incoming>Validate_flow13</bpmn:incoming>
      <bpmn:outgoing>Validate_flow14</bpmn:outgoing>
      <bpmn:outgoing>Validate_flow16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Validate_Wait" name="Wait 5 minutes">
      <bpmn:incoming>Validate_flow14</bpmn:incoming>
      <bpmn:outgoing>Validate_flow15</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Validate_Manual" name="Validate manually;&#10;enter signed evidence">
      <bpmn:incoming>Validate_flow16</bpmn:incoming>
      <bpmn:outgoing>Validate_flow17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Validate_flow13" sourceRef="Validate_Error" targetRef="Validate_Retry" name=""/>
    <bpmn:sequenceFlow id="Validate_flow14" sourceRef="Validate_Retry" targetRef="Validate_Wait" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">techAttempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Validate_flow15" sourceRef="Validate_Wait" targetRef="Validate_Check" name="Retry"/>
    <bpmn:sequenceFlow id="Validate_flow16" sourceRef="Validate_Retry" targetRef="Validate_Manual" name="No"/>
    <bpmn:sequenceFlow id="Validate_flow17" sourceRef="Validate_Manual" targetRef="Validate_Result" name=""/>
  </bpmn:process>
  <bpmn:process id="Process_Screen" name="Screen proposal (reusable)" isExecutable="false">
    <bpmn:laneSet id="Screen_lanes">
      <bpmn:lane id="Screen_lane0" name="Student / Team">
        <bpmn:flowNodeRef>Screen_Revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_Due</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Screen_lane1" name="Project Coordinator">
        <bpmn:flowNodeRef>Screen_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_Screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_Suitable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_Adjudicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_CanRevise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_Manual</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Screen_lane2" name="Review Committee / HoD">
        <bpmn:flowNodeRef>Screen_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Screen_lane3" name="Faculty Guide"/>
      <bpmn:lane id="Screen_lane4" name="Project Management System">
        <bpmn:flowNodeRef>Screen_Similarity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_Tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Screen_Revalidate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Screen_Start" name="Validated proposal">
      <bpmn:outgoing>Screen_flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Screen_Screen" name="Screen feasibility,&#10;resources and eligibility">
      <bpmn:incoming>Screen_flow1</bpmn:incoming>
      <bpmn:incoming>Screen_flow15</bpmn:incoming>
      <bpmn:outgoing>Screen_flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Screen_Suitable" name="Suitable?" default="Screen_flow6">
      <bpmn:incoming>Screen_flow2</bpmn:incoming>
      <bpmn:outgoing>Screen_flow3</bpmn:outgoing>
      <bpmn:outgoing>Screen_flow6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Screen_Similarity" name="Check similarity&#10;and duplicate topics">
      <bpmn:incoming>Screen_flow3</bpmn:incoming>
      <bpmn:outgoing>Screen_flow4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Screen_Match" name="Suspicious match?" default="Screen_flow7">
      <bpmn:incoming>Screen_flow4</bpmn:incoming>
      <bpmn:incoming>Screen_flow14</bpmn:incoming>
      <bpmn:outgoing>Screen_flow5</bpmn:outgoing>
      <bpmn:outgoing>Screen_flow7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Screen_End" name="Ready for committee">
      <bpmn:incoming>Screen_flow5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Screen_flow1" sourceRef="Screen_Start" targetRef="Screen_Screen" name=""/>
    <bpmn:sequenceFlow id="Screen_flow2" sourceRef="Screen_Screen" targetRef="Screen_Suitable" name=""/>
    <bpmn:sequenceFlow id="Screen_flow3" sourceRef="Screen_Suitable" targetRef="Screen_Similarity" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">screenPassed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Screen_flow4" sourceRef="Screen_Similarity" targetRef="Screen_Match" name=""/>
    <bpmn:sequenceFlow id="Screen_flow5" sourceRef="Screen_Match" targetRef="Screen_End" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not suspicious</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Screen_Adjudicate" name="Review evidence;&#10;choose revise or reject">
      <bpmn:incoming>Screen_flow6</bpmn:incoming>
      <bpmn:incoming>Screen_flow7</bpmn:incoming>
      <bpmn:outgoing>Screen_flow8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Screen_CanRevise" name="Revision justified&#10;and changes &lt; 2?" default="Screen_flow10">
      <bpmn:incoming>Screen_flow8</bpmn:incoming>
      <bpmn:outgoing>Screen_flow9</bpmn:outgoing>
      <bpmn:outgoing>Screen_flow10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Screen_Revise" name="Modify topic / scope;&#10;topicChanges +1 (7 days)">
      <bpmn:incoming>Screen_flow9</bpmn:incoming>
      <bpmn:outgoing>Screen_flow11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Screen_Due" name="7 days" attachedToRef="Screen_Revise" cancelActivity="true">
      <bpmn:outgoing>Screen_flow12</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Screen_Rejected" name="Rejected / lapsed:&#10;screening or plagiarism">
      <bpmn:incoming>Screen_flow10</bpmn:incoming>
      <bpmn:incoming>Screen_flow12</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_Closed"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Screen_flow6" sourceRef="Screen_Suitable" targetRef="Screen_Adjudicate" name="No"/>
    <bpmn:sequenceFlow id="Screen_flow7" sourceRef="Screen_Match" targetRef="Screen_Adjudicate" name="Yes"/>
    <bpmn:sequenceFlow id="Screen_flow8" sourceRef="Screen_Adjudicate" targetRef="Screen_CanRevise" name=""/>
    <bpmn:sequenceFlow id="Screen_flow9" sourceRef="Screen_CanRevise" targetRef="Screen_Revise" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">changeAllowed and topicChanges &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Screen_flow10" sourceRef="Screen_CanRevise" targetRef="Screen_Rejected" name="No"/>
    <bpmn:sequenceFlow id="Screen_flow11" sourceRef="Screen_Revise" targetRef="Screen_Revalidate" name="Changed proposal"/>
    <bpmn:sequenceFlow id="Screen_flow12" sourceRef="Screen_Due" targetRef="Screen_Rejected" name=""/>
    <bpmn:boundaryEvent id="Screen_Tech" name="Similarity unavailable" attachedToRef="Screen_Similarity" cancelActivity="true">
      <bpmn:outgoing>Screen_flow13</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Tech"/>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Screen_Manual" name="Compare repository&#10;manually; record evidence">
      <bpmn:incoming>Screen_flow13</bpmn:incoming>
      <bpmn:outgoing>Screen_flow14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Screen_flow13" sourceRef="Screen_Tech" targetRef="Screen_Manual" name=""/>
    <bpmn:sequenceFlow id="Screen_flow14" sourceRef="Screen_Manual" targetRef="Screen_Match" name=""/>
    <bpmn:callActivity id="Screen_Revalidate" name="Revalidate changed proposal" calledElement="Process_Validate">
      <bpmn:incoming>Screen_flow11</bpmn:incoming>
      <bpmn:outgoing>Screen_flow15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Screen_flow15" sourceRef="Screen_Revalidate" targetRef="Screen_Screen" name="Valid changed data"/>
  </bpmn:process>
