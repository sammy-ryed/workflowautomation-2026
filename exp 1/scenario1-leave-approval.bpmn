        <omgdi:waypoint x="400" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes1_di" bpmnElement="Flow_Yes1">
        <omgdi:waypoint x="425" y="245" />
        <omgdi:waypoint x="425" y="150" />
        <omgdi:waypoint x="500" y="150" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="402" y="188" width="46" height="14" />
