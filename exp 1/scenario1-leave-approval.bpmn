<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LeaveApproval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_LeaveApproval" name="Employee Leave Approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Employee Submits Leave Request">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckBalance" name="Check Leave Balance">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_BalanceCheck" name="Sufficient Balance?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes1</bpmn:outgoing>
      <bpmn:outgoing>Flow_No1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SendToManager" name="Send Request to Manager for Approval">
      <bpmn:incoming>Flow_Yes1</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="Manager Approves?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_UpdateBalance" name="Update Employee Leave Balance">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApprovalNotify" name="Send Approval Notification">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Approved" name="Leave Approved">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_RejectNotify" name="Send Rejection Notification">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Rejected" name="Leave Rejected">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_InsufficientNotify" name="Send Insufficient Balance Notification">
      <bpmn:incoming>Flow_No1</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Insufficient" name="Insufficient Balance">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CheckBalance" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckBalance" targetRef="Gateway_BalanceCheck" />
    <bpmn:sequenceFlow id="Flow_Yes1" name="Sufficient" sourceRef="Gateway_BalanceCheck" targetRef="Task_SendToManager" />
    <bpmn:sequenceFlow id="Flow_No1" name="Insufficient" sourceRef="Gateway_BalanceCheck" targetRef="Task_InsufficientNotify" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SendToManager" targetRef="Gateway_ManagerDecision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_ManagerDecision" targetRef="Task_UpdateBalance" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_ManagerDecision" targetRef="Task_RejectNotify" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_UpdateBalance" targetRef="Task_ApprovalNotify" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ApprovalNotify" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RejectNotify" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_InsufficientNotify" targetRef="EndEvent_Insufficient" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LeaveApproval">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="150" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="133" y="295" width="73" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckBalance_di" bpmnElement="Task_CheckBalance">
        <omgdc:Bounds x="240" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_BalanceCheck_di" bpmnElement="Gateway_BalanceCheck" isMarkerVisible="true">
